# ===== UDS Manager =====
EDS_URL=https://example-eds.test
EDS_LOGIN=your_login_here
EDS_PASSWORD=your_password_here
EDS_HEADLESS=true

# Browser origins allowed to call the API, separated by commas.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Required only when frontend and backend use different origins.
VITE_API_BASE_URL=

# ===== Supabase (опционально) =====
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ===== Приложение =====
VITE_APP_TITLE=UDS_Manager
VITE_APP_ENV=development
